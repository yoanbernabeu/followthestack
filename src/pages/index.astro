---
import Layout from '@/layouts/Layout.astro';
import Analyzer from '@/components/Analyzer';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const steps = [
  { n: '1', title: 'Pick your tools', text: 'Search the services, platforms and libraries your team uses.' },
  { n: '2', title: 'See who’s behind them', text: 'The companies, owners and leaders, and what they have publicly said and done.' },
  { n: '3', title: 'Decide for yourself', text: 'Every fact links to its sources. Alternatives are suggested when they exist.' },
];
---
<Layout>
  <div aria-hidden="true" class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[560px] w-screen -translate-x-1/2 bg-[radial-gradient(60%_60%_at_50%_0%,color-mix(in_oklch,var(--primary)_14%,transparent),transparent)]"></div>
  <section class="mx-auto mb-12 grid max-w-3xl gap-6 pt-6 text-center sm:pt-12">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">What’s behind your stack?</h1>
    <p class="mx-auto max-w-xl text-lg text-balance text-muted-foreground">
      Every tool you use is run, owned or funded by someone. Follow the Stack shows you who, with sources.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="#start" class="inline-flex h-10 items-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground hover:bg-primary/90">Start with your tools</a>
      <a href={`${base}about/`} class="inline-flex h-10 items-center rounded-md border px-6 text-sm font-medium hover:bg-muted">How it works</a>
    </div>
    <p class="text-xs text-muted-foreground">Free and open source · No account · Nothing leaves your browser</p>
  </section>

  <section class="mx-auto mb-16 grid max-w-4xl gap-6 sm:grid-cols-3">
    {steps.map((s) => (
      <div class="grid content-start gap-2 text-center sm:text-left">
        <span class="mx-auto flex size-8 items-center justify-center rounded-full bg-accent text-sm font-medium text-accent-foreground sm:mx-0">{s.n}</span>
        <h2 class="font-medium">{s.title}</h2>
        <p class="text-sm text-muted-foreground">{s.text}</p>
      </div>
    ))}
  </section>

  <div id="start" class="scroll-mt-6">
    <Analyzer client:load base={base} />
  </div>
</Layout>
