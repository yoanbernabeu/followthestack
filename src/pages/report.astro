---
import Layout from '@/layouts/Layout.astro';
import Analyzer from '@/components/Analyzer';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout title="A shared stack report" description="Someone shared what's behind their stack: the companies and people behind their tools, and what they have documentedly said and done. Check yours.">
  <Analyzer client:load base={base} shared />
</Layout>
