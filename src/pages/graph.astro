---
import Layout from '@/layouts/Layout.astro';
import GraphView from '@/components/GraphView';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout title="Graph" description="Explore the companies, owners, leaders and products in the database, and how they are linked.">
  <h1 class="mb-2 text-3xl font-semibold">Explore the graph</h1>
  <p class="mb-6 max-w-2xl text-muted-foreground">Every company, fund, person and product in the database, and the sourced links between them. Select a node to see its facts, search for a name, or highlight a grievance. Red nodes carry documented facts themselves; zoom in to read every name.</p>
  <GraphView client:load base={base} view="global" height="72vh" />
</Layout>
